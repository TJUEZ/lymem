# 麟忆尽智 lymem 配置（export 语法，按需取消注释）
# 端口（默认 8801）
#export LYMEM_PORT=8801
# 数据目录（默认 ~/.local/share/lymem）
#export LYMEM_DATA_DIR=

# ---- 向量数据库（竞赛正式通道）----
export LYMEM_VECTOR_BACKEND=kylin
# 仅开发/故障诊断时可临时改为 sqlite；正式验收不得使用。
#export LYMEM_VECTOR_BACKEND=sqlite

# ---- LLM 生成网关（可选；不配置时问答/偏好提取走规则兜底）----
#export LYMEM_LLM_API_KEY=
#export LYMEM_LLM_BASE_URL=
#export LYMEM_LLM_MODEL=
#export LYMEM_LLM_PROTOCOL=

# ---- 嵌入后端（默认麒麟端侧自动探测；无人值守可改）----
# 指向 kytensor HTTP 服务: export LYMEM_KYLIN_KYTENSOR_URL=http://127.0.0.1:8000
# 纯 CPU 兜底（无麒麟 AI 运行时时）: export LYMEM_EMBEDDER=hash
